# Dependencies, builds and local tool caches.
node_modules/
dist/
.vite/
.cache/
*.tsbuildinfo

# Test output can contain screenshots, traces and other private diagnostics.
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# Setup restores the model/runtime binaries; retain their pinned provenance.
/public/vision/*
!/public/vision/model-provenance.json

# Local logs, partial downloads, temporary files and editor backups.
logs/
*.[lL][oO][gG]
*.[lL][oO][gG].*
*.local
*.download
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# Never commit real environment values or private credentials.
.env
.env.*
!.env.example
!.env.*.example
[sS][eE][cC][rR][eE][tT][sS]/
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]12
*.[pP][fF][xX]

# Personal photos and documents, including formats not yet accepted by the app.
# Case-insensitive patterns also protect clones on case-sensitive systems.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[wW][eE][bB][pP]
*.[aA][vV][iI][fF]
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[dD][nN][gG]
*.[rR][aA][wW]
*.[cC][rR]2
*.[cC][rR]3
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[rR][aA][fF]
*.[pP][dD][fF]

